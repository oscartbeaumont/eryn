# Copy to .dev.vars and fill in. `pnpm dev` reads this file, and Cloudflare's
# Deploy to Cloudflare button turns every key here into a Worker secret.
#
# Discord: create an application at https://discord.com/developers/applications
# and add a bot to it. The portal shows the bot token under Bot, and the
# application id and public key under General Information.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_PUBLIC_KEY=

# Generate with:
#   echo "ENCRYPTION_KEY=$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=')"
#   echo "SESSION_SECRET=$(openssl rand -hex 32)"
ENCRYPTION_KEY=
SESSION_SECRET=

# The URL this Worker is served from, used in links and OAuth callbacks. After
# the first self-hosted deploy, set it to the Worker's workers.dev URL (or your
# own domain) and redeploy. Only the hosted deployment leaves it set here.
PUBLIC_ORIGIN=
