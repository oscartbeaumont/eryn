# Required. A base64url 32-byte key that seals every stored credential.
# Generate one with:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
ENCRYPTION_KEY=

# Optional. The public origin used in links and the MCP endpoint. A deployment
# that omits it learns its URL from the first request it serves.
PUBLIC_ORIGIN=http://localhost:5173

# Optional. The Discord bot token. Without one, Discord is simply disabled and
# iMessage still works.
DISCORD_BOT_TOKEN=

# Optional. Signs browser sessions. Derived from ENCRYPTION_KEY when unset.
SESSION_SECRET=

# Optional. Resend API key for email login codes. Without one, a development
# deployment logs the code to the console instead.
RESEND_API_KEY=

# Optional. The From address for login emails.
EMAIL_FROM=Eryn <login@eryn.example>
