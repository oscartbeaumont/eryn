# Copy to .dev.vars and fill in. `pnpm dev` reads this file, and Cloudflare's
# Deploy to Cloudflare button turns every key here into a Worker secret.
#
# Discord: create an application at https://discord.com/developers/applications
# and add a bot to it, then enable the Message Content Intent. The bot token is
# all Eryn needs: the application id, the key that signs interactions, and the
# deployment's public URL are read from Discord at runtime.
DISCORD_BOT_TOKEN=

# Seals stored provider and MCP credentials. Generate with:
#   echo "ENCRYPTION_KEY=$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=')"
ENCRYPTION_KEY=

# Optional overrides, only needed for development or a deployment that cannot
# learn these itself. `pnpm dev` reads them from this file when uncommented.
#   PUBLIC_ORIGIN    the origin used in links and OAuth callbacks
#   SESSION_SECRET   the key for MCP sign-in state; derived from ENCRYPTION_KEY
#                    when this is unset
