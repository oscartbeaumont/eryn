# Copy to `.dev.vars` and fill in. `cf deploy --secrets-file .dev.vars` uploads these.

# Discord bot token — Developer Portal → your app → Bot → Reset Token.
DISCORD_BOT_TOKEN=

# Discord OAuth2 client secret — Developer Portal → your app → OAuth2.
# Add the redirect URI https://eryn.otbeaumont.me/auth/callback in the same page.
DISCORD_CLIENT_SECRET=

# base64url, 32 random bytes. Protects guild API keys at rest.
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
ENCRYPTION_KEY=

# Random secret used to sign the OAuth state and session cookies.
#   openssl rand -hex 32
SESSION_SECRET=

# GitHub App (optional): powers the agent's GitHub tools (issues, clone, branch,
# commit, pull request). Create an App, set its Setup URL to
# https://eryn.otbeaumont.me/github/callback, then copy the App id, its private
# key (PEM), and its URL slug. Leave as-is to disable the GitHub tools.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
