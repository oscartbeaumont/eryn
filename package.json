{
  "name": "eryn",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=23.5.0"
  },
  "packageManager": "pnpm@10.33.1",
  "scripts": {
    "dev": "cf dev",
    "build": "cf build",
    "deploy": "cf deploy",
    "typecheck": "cf workers types && tsc && tsc -p tsconfig.landing.json",
    "check": "pnpm lint && pnpm typecheck && pnpm build",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "test": "node --experimental-strip-types --test src/bot/*.test.ts src/discord/*.test.ts src/plugins/*.test.ts src/session/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@opencode/client": "2.2.7",
    "@opencode/core": "2.2.7",
    "@opencode/plugin": "2.2.7",
    "@opencode/sdk": "2.2.7",
    "@opencode/server": "2.2.7",
    "effect": "4.1.0",
    "jsonc-parser": "3.3.1",
    "just-bash": "3.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.14",
    "@oxlint/plugins": "1.93.0",
    "@solidjs/vite-plugin": "3.0.0-next.57",
    "@solidjs/web": "2.0.0-rc.21",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "cf": "1.0.0-beta.29",
    "oxlint": "1.93.0",
    "solid-js": "2.0.0-rc.21",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "tree-sitter-bash",
      "tree-sitter-powershell",
      "@mongodb-js/zstd",
      "node-liblzma",
      "core-js"
    ],
    "overrides": {
      "seroval": "^1.7.6",
      "seroval-plugins": "^1.7.6",
      "fast-xml-parser@<5.12.0": "5.12.0",
      "glob@>=9.0.0 <=14.0.1": "14.0.2",
      "minimatch@>=7.0.0 <11.0.1": "11.0.1",
      "undici@>=7.0.0 <7.30.1": "7.30.1",
      "zod@<4.6.6": "4.6.7"
    }
  }
}
