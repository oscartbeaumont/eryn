  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@opencode/client": "2.2.5",
    "@opencode/core": "2.2.5",
    "@opencode/plugin": "2.2.5",
    "@opencode/sdk": "2.2.5",
    "@opencode/server": "2.2.5",
    "effect": "4.0.6",
    "just-bash": "3.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "beta",
    "@solidjs/vite-plugin": "3.0.0-next.57",
    "@solidjs/web": "2.0.0-rc.21",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.5",
    "cf": "^1.0.0-beta.18",
    "solid-js": "2.0.0-rc.21",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
