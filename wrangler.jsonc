// Metadata for Cloudflare's Deploy to Cloudflare button and Workers Builds.
//
// The project itself is configured by `cloudflare.config.ts` and built by
// `cf`, which ignores this file. The deploy button reads a Wrangler
// configuration to discover the Worker's name, bindings, and required
// resources; without one it would try to generate that configuration itself.
{
	"name": "eryn",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./assets",
		"run_worker_first": ["/brand/*", "/favicon.ico"]
	},
	"durable_objects": {
		"bindings": [
			{ "name": "BOT_GATEWAY", "class_name": "BotGateway" },
			{ "name": "BOT_SESSION", "class_name": "BotSession" }
		]
	},
	// The first migration. Nothing has been deployed from this file yet, so
	// there is no earlier class name to rename or carry over.
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["BotGateway", "BotSession"]
		}
	],
	// Workers Logs plus Cloudflare's error aggregation. `cloudflare.config.ts`
	// is what `cf deploy` reads and already enables both; this copy exists for
	// the deploy button and Workers Builds.
	"observability": {
		"enabled": true,
		"issues": {
			"enabled": true
		}
	}
}
