// Metadata for Cloudflare's Deploy to Cloudflare button and Workers Builds.
//
// The project itself is configured by `cloudflare.config.ts` and built by
// `cf`, which ignores this file. The deploy button reads a Wrangler
// configuration to discover the Worker's name, bindings, and required
// resources; without one it would try to generate that configuration itself.
{
	"name": "eryn",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-20",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./assets",
		"run_worker_first": ["/brand/*", "/favicon.ico"]
	},
	"durable_objects": {
		"bindings": [
			{ "name": "CONTROL", "class_name": "Control" },
			{ "name": "SERVER", "class_name": "Server" },
			{ "name": "HUB", "class_name": "Hub" },
			{ "name": "GATEWAY", "class_name": "Gateway" }
		]
	},
	// v1 is the original Discord-only bot. v2 is the decoupled redesign; a
	// fresh deployment applies both, and an existing one keeps its old objects
	// until they are deleted.
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["BotGateway", "BotSession"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["Control", "Server", "Hub", "Gateway"]
		}
	],
	"worker_loaders": [{ "binding": "PLUGIN_LOADER" }],
	"r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "eryn-artifacts" }],
	"observability": {
		"enabled": true,
		"issues": {
			"enabled": true
		}
	}
}
