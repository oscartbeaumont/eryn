// Metadata for Cloudflare's Deploy to Cloudflare button and Workers Builds.
//
// The project itself is configured by `cloudflare.config.ts` and built by
// `cf`, which ignores this file. The deploy button reads a Wrangler
// configuration to discover the Worker's name, bindings, and required
// resources; without one it would try to generate that configuration itself.
{
	"name": "eryn",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./assets",
		"run_worker_first": ["/brand/*", "/favicon.ico"]
	},
	"durable_objects": {
		"bindings": [
			{ "name": "BOT_GATEWAY", "class_name": "BotGateway" },
			{ "name": "BOT_SESSION", "class_name": "BotSession" }
		]
	},
	// The V5 names were the classes' first names; the second migration carries
	// their namespaces over so a Worker that already applied the first one keeps
	// its data. A fresh deploy just runs both in order.
	"migrations": [
		{
			"tag": "v5",
			"new_sqlite_classes": ["BotGatewayV5", "BotSessionV5"]
		},
		{
			"tag": "v6",
			"renamed_classes": [
				{ "from": "BotGatewayV5", "to": "BotGateway" },
				{ "from": "BotSessionV5", "to": "BotSession" }
			]
		}
	],
	"observability": {
		"enabled": true
	}
}
