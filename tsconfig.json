{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": [],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": {
      "@opencode/sdk/internal/host": ["./node_modules/@opencode/sdk/dist/internal/host.d.ts"]
    }
  },
  "include": [
    "src",
    "packages/gateway/src",
    "packages/bot/src",
    "cloudflare.config.ts",
    ".cloudflare/types"
  ],
  "exclude": ["packages/console"]
}
